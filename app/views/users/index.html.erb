<div class="page-heading">
  <div>
    <h1>ユーザー管理</h1>
    <p class="muted">ユーザー停止時も、そのユーザーが登録した会社・担当者・名刺・メモはOrganizationの資産として残ります。</p>
  </div>
  <%= link_to "ユーザーを作成", new_user_path, class: "button subtle-button" %>
</div>

<table>
  <thead>
    <tr><th>名前</th><th>メール</th><th>Organization</th><th>権限</th><th>状態</th><th></th></tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.organization&.name %></td>
        <td><%= user.role %></td>
        <td><%= user.archived? ? "停止中" : "有効" %></td>
        <td class="actions">
          <% if user.manageable_by?(current_user) %>
            <%= link_to "編集", edit_user_path(user) %>
            <% if user.archived? %>
              <%= button_to "復元", restore_user_path(user), method: :patch %>
            <% else %>
              <%= button_to "停止", archive_user_path(user), method: :patch, class: "danger" %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
