<div class="page-heading">
  <div>
    <h1>会社検索</h1>
    <p class="muted">会社名・電話・住所から探せます。</p>
  </div>
  <%= link_to "会社を登録", new_company_path, class: "button subtle-button" %>
</div>

<%= form_with url: companies_path, method: :get, class: "search-panel compact-search" do |form| %>
  <%= form.search_field :q, value: @q, placeholder: "会社名・電話・住所で検索" %>
  <%= form.submit "検索", class: "secondary" %>
<% end %>

<table>
  <thead>
    <tr><th>会社名</th><th>電話</th><th>Web</th><th></th></tr>
  </thead>
  <tbody>
    <% @companies.each do |company| %>
      <tr>
        <td><%= link_to company.name, company %></td>
        <td><%= company.phone %></td>
        <td><%= link_to company.website, company.website if company.website.present? %></td>
        <td><%= link_to "編集", edit_company_path(company) if company.editable_by?(current_user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
