<h1><%= @company.name %></h1>
<%= render "shared/duplicates", candidates: @duplicate_candidates %>

<div class="actions">
  <%= link_to "編集", edit_company_path(@company), class: "button secondary" if @company.editable_by?(current_user) %>
  <% if @company.archived? %>
    <%= button_to "表示に戻す", restore_company_path(@company), method: :patch if @company.restorable_by?(current_user) %>
  <% elsif @company.editable_by?(current_user) %>
    <%= button_to "非表示にする", archive_company_path(@company), method: :patch, class: "danger" %>
  <% end %>
  <%= link_to "担当者を登録", new_contact_path(company_id: @company.id), class: "button" %>
</div>

<div class="panel">
  <p><strong>Organization:</strong> <%= @company.organization.name %></p>
  <p><strong>Web:</strong> <%= link_to @company.website, @company.website if @company.website.present? %></p>
  <p><strong>電話:</strong> <%= @company.phone %></p>
  <p><strong>住所:</strong><br><%= simple_format(@company.address) %></p>
  <p><strong>説明:</strong><br><%= simple_format(@company.description) %></p>
</div>

<h2>担当者</h2>
<table>
  <thead><tr><th>名前</th><th>役職</th><th>メール</th></tr></thead>
  <tbody>
    <% @contacts.each do |contact| %>
      <tr>
        <td><%= link_to contact.name, contact %></td>
        <td><%= contact.position %></td>
        <td><%= mail_to contact.email if contact.email.present? %></td>
      </tr>
    <% end %>
  </tbody>
</table>
